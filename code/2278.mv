# i++ - increment a digit character
# Read '0'-'9' and output the next digit (mod 10)

A<I      # Read input character

# Increment: A + 1
# But if A is '9' (57), output '0' (48)

# Strategy: increment A, then check if it's 58 (which is '9' + 1)
# If it's 58, output 48 ('0'), otherwise output A + 1

# Create a lookup table
# For '0' (48) -> '1' (49)
# For '1' (49) -> '2' (50)
# ...
# For '9' (57) -> '0' (48)

[48]<49   # '0' -> '1'
[49]<50   # '1' -> '2'
[50]<51   # '2' -> '3'
[51]<52   # '3' -> '4'
[52]<53   # '4' -> '5'
[53]<54   # '5' -> '6'
[54]<55   # '6' -> '7'
[55]<56   # '7' -> '8'
[56]<57   # '8' -> '9'
[57]<48   # '9' -> '0'

# Output the incremented value
O<[A]

Z<1      # Halt

